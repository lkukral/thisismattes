---
import { getImage, Image } from "astro:assets";
import mattesBackground from "../../assets/mattes_background.jpg";
import campaignBackground from "../../assets/muenchen-singt-background.jpg";
import campaignSticker from "../../assets/st-brown-campaign-sticker.jpg";
import { showCampaignOnHomepage } from "../../config/campaign";
import mattesLogo from "../../assets/mattes_logo_1500w.png";
import stBrownArtwork from "../../assets/st-brown-artwork.webp";
import zaertlicherApplausArtwork from "../../assets/artwork_zaertlicher_applaus.jpg";
import { getContent, localizedPath, type Locale } from "../../i18n";
import { campaignContent } from "../../campaign-content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitch from "../LanguageSwitch.astro";
import LucideIcon from "../LucideIcon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getContent(locale);
const { home } = copy;
const optimizedHeroBackground = await getImage({ src: showCampaignOnHomepage ? campaignBackground : mattesBackground, width: 1920, format: "webp", quality: "high" });
---

<BaseLayout title={home.meta.title} description={home.meta.description} locale={locale} page="home">
  <main id="main-content" class="mattes-site">
    <section class="hero" id="top" aria-label="Mattes" style={`--hero-background: url(${optimizedHeroBackground.src})`}>
      {showCampaignOnHomepage && <div class="hero-campaign-blur" aria-hidden="true"></div>}
      <div class="hero-shade"></div>
      <header class="site-header">
        <a class="wordmark" href="#top" aria-label={home.hero.homeLabel}>MATTES</a>
        <div class="site-header-actions">
          <nav aria-label={copy.shared.siteNavigation}>
            <a href="#musik">{home.nav.music}</a><a href="#mattes">{home.nav.about}</a><a href="#live">{home.nav.live}</a>
          </nav>
          <LanguageSwitch locale={locale} page="home" />
        </div>
      </header>
      <div class="hero-content">
        {showCampaignOnHomepage ? (
          <div class="hero-campaign-card">
            <Image class="hero-campaign-sticker" src={campaignSticker} alt={campaignContent[locale].imageAlt} width={512} />
            <a class="hero-campaign-banner" href={localizedPath(locale, "campaign")}>
              <span>
                <small>{campaignContent[locale].event}</small>
                <strong>{campaignContent[locale].heading.join(" ")}</strong>
              </span>
              <LucideIcon name="arrow-up-right" />
            </a>
          </div>
        ) : (
          <Image class="hero-logo" src={mattesLogo} alt="Mattes" width={570} />
        )}
      </div>
      <a class="scroll-cue" href="#release-card" aria-label={home.hero.scrollLabel}><span>{home.hero.scroll}</span><LucideIcon name="arrow-down" /></a>
    </section>

    <section class="featured-release" id="release-card" aria-labelledby="featured-release-heading">
      <div class="featured-card">
        <div class="image-frame featured-artwork"><Image src={stBrownArtwork} alt={home.featured.coverAlt} layout="constrained" /></div>
        <div class="featured-copy"><p class="eyebrow">{home.featured.label}</p><h1 id="featured-release-heading">St. Brown</h1><p>{home.featured.description}</p></div>
        <div class="featured-actions"><a class="button button-primary" href={localizedPath(locale, "release")}>{home.featured.releaseLink} <LucideIcon name="arrow-up-right" /></a><a class="button button-ghost" href="https://www.instagram.com/thisismattes" target="_blank" rel="noreferrer">Instagram</a><a class="button button-ghost" href="https://www.tiktok.com/@thisismattes" target="_blank" rel="noreferrer">TikTok</a></div>
      </div>
    </section>

    <section class="release section" id="musik" aria-labelledby="release-heading">
      <div class="section-kicker"><span>01</span> {home.release.sectionLabel}</div>
      <div class="release-grid">
        <div class="image-frame release-artwork"><Image src={stBrownArtwork} alt={home.release.coverAlt} layout="constrained" /></div>
        <div class="release-info"><p class="eyebrow dark">{home.release.label}</p><h2 id="release-heading">St. Brown</h2><p class="intro">{home.release.description}</p><div class="stream-list"><span>{home.release.streamingLabel}</span><a href="https://listen.music-hub.com/EfEaxn" target="_blank" rel="noreferrer">{home.release.streamingLink} <LucideIcon name="arrow-up-right" /></a></div></div>
      </div>
      <div class="more-releases" aria-labelledby="more-releases-heading"><p id="more-releases-heading">{home.release.moreLabel}</p><a class="more-release" href="https://open.spotify.com/intl-de/track/7g28jZp5Hl9X5JQvC5TjK9?si=1da5a988f4ae4f2e" target="_blank" rel="noreferrer"><div class="image-frame more-release-artwork"><Image src={zaertlicherApplausArtwork} alt={home.release.previousCoverAlt} width={168} /></div><span><strong>Zärtlicher Applaus</strong><small>{home.release.previousType}</small></span><LucideIcon name="arrow-up-right" /></a></div>
    </section>

    <section class="statement" aria-label={home.statement.label}><div class="statement-mark"><LucideIcon name="sparkles" /></div><p>{home.statement.lineOne}<br /><em>{home.statement.emphasis}</em><br />{home.statement.lineThree}</p><div class="statement-tags">{home.statement.tags.map((tag) => <span>{tag}</span>)}</div></section>

    <section class="about section" id="mattes" aria-labelledby="about-heading"><div class="section-kicker"><span>02</span> {home.about.sectionLabel}</div><div class="about-grid"><div><h2 id="about-heading">{home.about.heading[0]}<br />{home.about.heading[1]}<br /><span>{home.about.heading[2]}</span></h2><div class="icon-strip" aria-hidden="true"><span><LucideIcon name="heart" /></span><span><LucideIcon name="star" /></span><span>10</span><span><LucideIcon name="arrow-up-right" /></span></div></div><div class="about-copy">{home.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}<a class="text-link" href="https://www.instagram.com/thisismattes" target="_blank" rel="noreferrer">{home.about.instagramLink} <LucideIcon name="arrow-up-right" /></a></div></div></section>

    <section class="live section" id="live" aria-labelledby="live-heading"><div class="section-kicker light"><span>03</span> {home.live.sectionLabel}</div><div class="live-heading-row"><h2 id="live-heading">{home.live.heading[0]}<br /><span>{home.live.heading[1]}</span></h2><p>{home.live.description}</p></div><div class="dates">{home.live.events.map((event) => <article class="date"><time datetime={event.date}>{event.displayDate}</time><div><h3>{event.city}</h3><p>{event.venue}</p></div><span class="date-status">{event.status}</span></article>)}</div></section>

    <footer class="site-footer"><a class="footer-logo" href="#top">MATTES</a><p>{home.footer.tagline}</p><div class="footer-actions"><div class="footer-links"><a href="mailto:hello@thisismattes.de">hello@thisismattes.de</a><a href={localizedPath(locale, "legal")}>{home.footer.legal}</a><a href="https://www.instagram.com/thisismattes" target="_blank" rel="noreferrer">Instagram</a><a href="https://www.tiktok.com/@thisismattes" target="_blank" rel="noreferrer">TikTok</a></div><LanguageSwitch locale={locale} page="home" /></div><span class="copyright">© 2026 Mattes</span></footer>
  </main>
</BaseLayout>

<style>
  .hero-campaign-blur {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(64px);
    pointer-events: none;
  }

  .hero-campaign-card {
    width: 100%;
    max-width: 400px;
    margin-inline: auto;
  }

  .hero-campaign-sticker {
    display: block;
    width: 100%;
    height: auto;
  }

  .hero-campaign-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    background: var(--stb-yellow, #ffd740);
    color: #101010;
    text-align: left;
  }

  .hero-campaign-banner:hover { background: #ffe784; }
  .hero-campaign-banner small, .hero-campaign-banner strong { display: block; }
  .hero-campaign-banner small { margin-bottom: .25rem; }
  .hero-campaign-banner strong { line-height: 1.25; }
  .hero-campaign-banner svg { flex-shrink: 0; }
</style>

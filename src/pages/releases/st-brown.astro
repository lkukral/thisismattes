---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LucideIcon from "../../components/LucideIcon.astro";
import { Image } from "astro:assets";
import stBrownArtwork from "../../assets/st-brown-artwork.webp";
import mattesProfile from "../../assets/mattes_profile.jpg";
import touchdownImage from "../../assets/touchdown.png";
---

<BaseLayout title="St. Brown | Mattes" description="St. Brown von Mattes – für Football, harte Arbeit und den Willen, weiterzugehen.">
  <main id="main-content" class="stb-page">
    <section class="stb-hero" aria-labelledby="stb-title">
      <Image class="stb-hero-backdrop" src={stBrownArtwork} alt="" loading="eager" />
      <header class="stb-header"><a class="stb-wordmark" href="/" aria-label="Zur Mattes Homepage">MATTES</a><span>Release 2026</span></header>
      <div class="stb-hero-content"><p class="stb-kicker">Die neue Single</p><h1 id="stb-title">St. Brown</h1><Image class="stb-cover" src={stBrownArtwork} alt="Cover der Single St. Brown von Mattes" priority layout="constrained" /><div class="stb-hero-actions"><a class="stb-button stb-button-primary" href="https://listen.music-hub.com/EfEaxn" target="_blank" rel="noreferrer">Jetzt streamen <LucideIcon name="arrow-up-right" /></a><a class="stb-button stb-button-secondary" href="#touchdown">Zur Touchdown Version <LucideIcon name="arrow-down" /></a></div></div>
    </section>

    <section class="stb-story" aria-labelledby="song-heading"><div class="stb-section-label"><span>01</span> Über den Song</div><div class="stb-story-grid"><div class="stb-portrait-wrap"><Image src={mattesProfile} alt="Mattes" class="stb-portrait" layout="constrained" /><span class="stb-portrait-caption">MATTES · DETROIT / MÜNCHEN</span></div><div class="stb-story-copy"><h2 id="song-heading">Mehr als<br /><em>Football.</em></h2><p>Über seine Mutter hat Mattes familiäre Wurzeln in Detroit. Die Verbindung zur Stadt und zu den Detroit Lions ist für ihn deshalb mehr als nur Fanliebe.</p><p>In „St. Brown“ erzählt er, warum er sich mit dem Sport, Amon-Ra St. Brown und den Lions so stark identifiziert: Harte Arbeit und der unbedingte Wille führen am Ende zum Erfolg. Für diesen Weg lohnt es sich zu kämpfen.</p><p>Der Song steht für alle, die nach Erfolg streben, ohne zu vergessen, woher sie kommen und welchen Weg sie schon gegangen sind.</p><a class="stb-story-link" href="https://www.instagram.com/thisismattes" target="_blank" rel="noreferrer">Mattes auf Instagram <LucideIcon name="arrow-up-right" /></a></div></div></section>

    <section class="stb-touchdown" id="touchdown" aria-labelledby="touchdown-heading"><Image class="stb-touchdown-background" src={touchdownImage} alt="" layout="full-width" /><div class="stb-touchdown-content"><div class="stb-section-label stb-section-label-light"><span>02</span> Für den Moment danach</div><h2 id="touchdown-heading">Lade dir die<br /><em>Touchdown Version</em><br />herunter.</h2><p>Dieser Edit kann bei einem Touchdown von Amon-Ra St. Brown laufen, um das ganze Stadion anzuheizen. Lade ihn dir herunter und feiere jeden Touchdown von St. Brown.</p><a class="stb-button stb-button-download" href="https://drive.google.com/file/d/1rhnjFfbq7fjGmo4c9LUPBTKQaDGHAeUM/view?usp=sharing" target="_blank" rel="noreferrer">Touchdown Version herunterladen <LucideIcon name="arrow-down" /></a></div></section>

    <section class="stb-connect" aria-labelledby="connect-heading"><div><div class="stb-section-label"><span>03</span> Mattes</div><h2 id="connect-heading">Mehr<br />von Mattes.</h2></div><div class="stb-social-links" aria-label="Mattes folgen"><a href="https://www.instagram.com/thisismattes" target="_blank" rel="noreferrer">Instagram <LucideIcon name="arrow-up-right" /></a><a href="https://www.tiktok.com/@thisismattes" target="_blank" rel="noreferrer">TikTok <LucideIcon name="arrow-up-right" /></a><a href="/">Zur Homepage <LucideIcon name="arrow-up-right" /></a></div></section>
    <footer class="stb-footer"><a href="/">MATTES</a><span>St. Brown · 2026</span></footer>
  </main>
</BaseLayout>
